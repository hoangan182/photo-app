<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền truy cập Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Quyền đọc ảnh từ bộ nhớ, tùy theo API -->
    <!-- Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android dưới 13 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:name=".PhotoBoothApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoBoothLogin"
        tools:targetApi="31">

        <activity
            android:name=".activity.AllAlbumActivity"
            android:exported="false" />
        <activity
            android:name=".activity.AlbumDetailActivity"
            android:exported="false" />
        <activity
            android:name=".activity.FullScreenDeletedImage"
            android:exported="false" />
        <activity
            android:name=".activity.VideoActivity"
            android:exported="false" />
        <activity
            android:name=".activity.ChangeInformationActivity"
            android:exported="false" />
        <activity
            android:name=".activity.AddAlbumActivity"
            android:exported="false" />
        <activity
            android:name=".activity.AllPhotoActivity"
            android:exported="false" />
        <activity
            android:name=".activity.FullScreenImageActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".activity.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".activity.FavoriteActivity"
            android:exported="false" />
        <activity
            android:name=".activity.TrashActivity"
            android:exported="false" />
        <activity
            android:name=".activity.SignUpActivity"
            android:exported="false" />
        <activity
            android:name=".activity.ChangePasswordActivity"
            android:exported="false" />
        <activity
            android:name=".activity.StartActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- MainActivity (không phải launcher) -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="false" />
        <activity
            android:name=".activity.ImageEditActivity"
            android:exported="false" />

    </application>

</manifest>
